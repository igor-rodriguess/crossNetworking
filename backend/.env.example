# =============================================================================
# Conexão com o banco (Supabase / PostgreSQL 16) — use o Session pooler (IPv4).
# A Direct connection do Supabase é IPv6-only e não funciona em redes IPv4.
# =============================================================================

# Aplicação: papel de PRIVILÉGIO MÍNIMO (cross_app) — sem DDL, sem superusuário.
# Formato: postgresql://cross_app.<project-ref>:<senha>@aws-<n>-<região>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://cross_app.<project-ref>:<senha-app>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Migrations: papel ADMINISTRATIVO (postgres). Usado apenas pelo runner db:migrate.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<senha-postgres>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Banco da SUÍTE AUTOMATIZADA — obrigatório para rodar `npm test`.
#
# Os testes criam clientes, projetos e candidaturas reais. Sem esta variável a
# suíte se recusa a rodar, em vez de cair na base de produção: foi assim que 25
# clientes "Cli * E2E" acabaram no banco real (limpos pela migration 051).
#
#   docker compose up -d db-test     # sobe o Postgres de teste na porta 5433
#   npm run db:migrate:test          # aplica o schema nele
#   npm test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cross_test

# Porta da API
PORT=3000

# Ambiente: development | test | production
NODE_ENV=development

# =============================================================================
# Autenticação (RF001)
# =============================================================================
# Segredo de assinatura dos tokens (HMAC-SHA256). OBRIGATÓRIO em produção.
# Gere um valor aleatório forte, por ex.: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-caracteres-ou-mais
# Duração do access token (minutos) e do refresh token (dias).
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# =============================================================================
# Borda / segurança
# =============================================================================
# Origens permitidas no CORS (lista separada por vírgula). Em produção, NÃO use *.
CORS_ORIGIN=*
# Em produção, configure as origens exatas e nunca use `*`. Ative apenas se a
# API estiver atrás de proxy confiável.
TRUST_PROXY=false
# Limite máximo do JSON aceito pela API.
REQUEST_BODY_LIMIT=1mb
# Rate limit global (janela e máximo de requisições por IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Tempo máximo para drenar conexões após SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# Token exclusivo do coletor de métricas. Obrigatório em produção; não reutilize
# JWT_SECRET. Envie em Authorization: Bearer <METRICS_TOKEN> para GET /metrics.
METRICS_TOKEN=troque-por-outro-segredo-aleatorio-de-32-caracteres-ou-mais

# =============================================================================
# Agentes de IA (pipeline multiagente)
# =============================================================================
# SEM a chave do provedor selecionado, os agentes rodam em MODO MOCK (stub
# determinístico) — dá para desenvolver e testar sem custo. Preencha quando for
# ligar as APIs reais.
#
# Provedor do LLM de raciocínio: deepseek | openai. O DeepSeek é compatível com
# o formato da OpenAI e tem custo bem menor; é o padrão.
AI_PROVIDER=ollama
# DeepSeek: obtenha a chave em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_MS=90000
# OpenAI: só necessária para os EMBEDDINGS do RAG (o DeepSeek não tem embeddings)
# ou se AI_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo LLM da OpenAI (usado só quando AI_PROVIDER=openai). Ex.: gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Modelo de embeddings do RAG (busca semântica). text-embedding-3-small tem
# 1536 dimensões — DEVE casar com a coluna vector(1536) do banco.
OPENAI_EMBED_MODEL=text-embedding-3-small
# Firecrawl para coleta web (Source Collector). https://www.firecrawl.dev
FIRECRAWL_API_KEY=
# Força o modo mock mesmo com chave presente (ex.: em CI). true|false
AI_MOCK=false

# --- Guardrails de custo -----------------------------------------------------
#
# Duas camadas INDEPENDENTES. Confundi-las é erro comum:
#
#   AI_PAID_PROVIDERS_ENABLED  → libera provedores PAGOS
#   AI_ALLOWED_LLM_OPERATIONS  → declara QUAIS operações podem chamar LLM
#
# Uma chave presente no .env não é, por si só, autorização para gastar.

# Kill switch dos provedores pagos (OpenAI, DeepSeek, Firecrawl, embeddings).
# Ollama é ISENTO: roda local, custo zero, mesmo com isto em false.
AI_PAID_PROVIDERS_ENABLED=false

# Allowlist de operações autorizadas a consumir LLM. Vazio = nenhuma.
# Um agente novo NÃO ganha acesso a LLM só por ter sido escrito: habilitar é
# decisão explícita de operação e de custo.
#
# Operações reconhecidas:
#   fact_extraction           — extração de fatos com quote validada (AI-02.3)
#   crossability_reasoning    — raciocínio Crossability (AI-04)
#   cross_knowledge_embedding — embeddings do Cross Knowledge (AI-01)
#
# Para rodar o Crossability com Ollama (custo zero):
#   AI_ALLOWED_LLM_OPERATIONS=fact_extraction,crossability_reasoning
AI_ALLOWED_LLM_OPERATIONS=fact_extraction
