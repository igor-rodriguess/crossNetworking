# =============================================================================
# Conexão com o banco (Supabase / PostgreSQL 16) — use o Session pooler (IPv4).
# A Direct connection do Supabase é IPv6-only e não funciona em redes IPv4.
# =============================================================================

# Aplicação: papel de PRIVILÉGIO MÍNIMO (cross_app) — sem DDL, sem superusuário.
# Formato: postgresql://cross_app.<project-ref>:<senha>@aws-<n>-<região>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://cross_app.<project-ref>:<senha-app>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Migrations: papel ADMINISTRATIVO (postgres). Usado apenas pelo runner db:migrate.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<senha-postgres>@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Porta da API
PORT=3000

# Ambiente: development | test | production
NODE_ENV=development

# =============================================================================
# Autenticação (RF001)
# =============================================================================
# Segredo de assinatura dos tokens (HMAC-SHA256). OBRIGATÓRIO em produção.
# Gere um valor aleatório forte, por ex.: openssl rand -base64 48
JWT_SECRET=troque-por-uma-string-aleatoria-de-32-caracteres-ou-mais
# Duração do access token (minutos) e do refresh token (dias).
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# =============================================================================
# Borda / segurança
# =============================================================================
# Origens permitidas no CORS (lista separada por vírgula). Em produção, NÃO use *.
CORS_ORIGIN=*
# Em produção, configure as origens exatas e nunca use `*`. Ative apenas se a
# API estiver atrás de proxy confiável.
TRUST_PROXY=false
# Limite máximo do JSON aceito pela API.
REQUEST_BODY_LIMIT=1mb
# Rate limit global (janela e máximo de requisições por IP).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Tempo máximo para drenar conexões após SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# Token exclusivo do coletor de métricas. Obrigatório em produção; não reutilize
# JWT_SECRET. Envie em Authorization: Bearer <METRICS_TOKEN> para GET /metrics.
METRICS_TOKEN=troque-por-outro-segredo-aleatorio-de-32-caracteres-ou-mais
