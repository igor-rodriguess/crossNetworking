{
  "name": "cross-platform-backend",
  "version": "0.1.0",
  "description": "Backend da Plataforma Cross - Crossnetworking",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts status",
    "db:test": "tsx scripts/test-db.ts",
    "db:health": "tsx scripts/db-health.ts",
    "db:backup": "tsx scripts/db-backup.ts"
  },
  "dependencies": {
